#!/bin/bash
# 群晖 SPK 生命周期脚本公共函数与路径定义
# 被 preinst/postinst/postupgrade/preuninst/postuninst/start-stop-status source

PKG="Aria2"
# DSM7 安全模型：守护进程以套件系统用户 sc-Aria2 运行（由框架自动创建）
PKG_USER="sc-$PKG"

: "${SYNOPKG_PKGDEST:=/var/packages/$PKG/target}"

# 部分调用场景可能没有 SYNOPKG_PKGDEST_VOL，从 target 软链接 (/volumeX/@appstore/Aria2) 反推
if [ -z "${SYNOPKG_PKGDEST_VOL:-}" ]; then
    LINK_TARGET="$(readlink "$SYNOPKG_PKGDEST" 2>/dev/null)"
    case "$LINK_TARGET" in
        /volume*) SYNOPKG_PKGDEST_VOL="${LINK_TARGET%%/@appstore/*}" ;;
    esac
    : "${SYNOPKG_PKGDEST_VOL:=/volume1}"
fi

# 运行数据目录优先使用框架提供的 SYNOPKG_PKGVAR（/volumeX/@appdata/Aria2）
DATA_DIR="${SYNOPKG_PKGVAR:-$SYNOPKG_PKGDEST_VOL/@appdata/$PKG}"
# 默认下载目录在 resolve_share_path 后确定
DOWNLOAD_DIR=""
CONF_FILE="$DATA_DIR/aria2.conf"
UI_CONF_FILE="$DATA_DIR/ui.conf"
PATHS_CONF="$SYNOPKG_PKGDEST/conf/paths.conf"
TPL_FILE="$SYNOPKG_PKGDEST/template/aria2.tpl"
ARIA2C_BIN="$SYNOPKG_PKGDEST/server/aria2c"
PID_FILE="$DATA_DIR/aria2.pid"

# 解析向导指定的共享文件夹真实路径
# data-share 资源 worker 会在安装时创建共享并在 /var/packages/<PKG>/shares/<名称> 建软链
resolve_share_path() {
    local share_name="$1"
    local link="/var/packages/$PKG/shares/$share_name"
    local p=""
    p="$(realpath "$link" 2>/dev/null)"
    if [ -z "$p" ] || [ ! -d "$p" ]; then
        if command -v synoshare >/dev/null 2>&1 && synoshare --get "$share_name" >/dev/null 2>&1; then
            p="$(synoshare --get "$share_name" | awk 'NR==4' | cut -d] -f1 | cut -d[ -f2)"
        fi
    fi
    [ -z "$p" ] && p="$SYNOPKG_PKGDEST_VOL/$share_name"
    echo "$p"
}

# CGI（http 用户运行）读取的路径配置，只包含路径不含密钥
write_paths_conf() {
    mkdir -p "$(dirname "$PATHS_CONF")"
    cat > "$PATHS_CONF" <<EOF
WWW_DIR="$SYNOPKG_PKGDEST/www"
DATA_DIR="$DATA_DIR"
CONF_FILE="$CONF_FILE"
UI_CONF_FILE="$UI_CONF_FILE"
DOWNLOAD_DIR="$DOWNLOAD_DIR"
EOF
    chmod 755 "$(dirname "$PATHS_CONF")"
    chmod 644 "$PATHS_CONF"
}

# 渲染 aria2.conf：$1=密钥 $2=端口
render_conf() {
    local secret="$1"
    local port="$2"
    sed \
        -e "s|\${PRC_SECRET}|${secret}|g" \
        -e "s|\${RPC_PORT}|${port}|g" \
        -e "s|\${DATA_DIR}|$DATA_DIR|g" \
        -e "s|\${DOWNLOAD_DIR}|$DOWNLOAD_DIR|g" \
        "$TPL_FILE" > "$CONF_FILE"
    chmod 644 "$CONF_FILE"
}

# 向导入参（兼容 $name 与 $wizard_name 两种注入约定）
wizard_value() {
    local key="$1"
    local def="$2"
    local val
    eval "val=\${$key:-}"
    if [ -z "$val" ]; then
        eval "val=\${wizard_$key:-}"
    fi
    echo "${val:-$def}"
}
