#!/bin/bash
# 文件复制完成后执行：创建数据目录、生成配置与钩子、初始化数据文件

. "$(dirname "$0")/common"
set -e

RPC_SECRET="$(wizard_value rpc_secret aria2rpc_secret)"
RPC_PORT="$(wizard_value rpc_port 6800)"

# 数据目录（@appdata）与下载目录（系统默认共享文件夹 downloads）
mkdir -p "$DATA_DIR" "$DOWNLOAD_DIR"
chmod 777 "$DATA_DIR"
chmod 755 "$ARIA2C_BIN"

# CGI 路径配置、下载完成钩子、aria2.conf
write_paths_conf
write_hook
render_conf "$RPC_SECRET" "$RPC_PORT"

# 初始化运行期文件；ui.conf 需被 CGI（http 用户）改写，放 666
for file in aria2.session dht.dat dht6.dat; do
    [ ! -f "$DATA_DIR/$file" ] && touch "$DATA_DIR/$file"
done
[ ! -f "$UI_CONF_FILE" ] && touch "$UI_CONF_FILE"
chmod 666 "$UI_CONF_FILE"

exit 0
