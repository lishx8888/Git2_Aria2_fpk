#!/bin/bash
# DSM 安装向导：
#   installer -e          是否显示向导（全新安装 true，升级 false）
#   installer -g          输出向导定义 JSON
#   installer -s '<json>' 用户提交结果（$2 为 JSON），校验失败 exit 非 0
# 向导结果由套件中心以环境变量形式注入 preinst/postinst（兼容 $name / $wizard_name）

PKG="Aria2"

case "${1:-}" in
    -e)
        # 升级时 /var/packages/Aria2 已存在，跳过向导
        if [ -d "/var/packages/$PKG" ]; then
            echo "false"
        else
            echo "true"
        fi
        ;;
    -g)
        cat <<'JSON'
[
  {
    "step_title": "Aria2 RPC 设置",
    "items": [
      {
        "type": "password",
        "desc": "RPC 访问密钥（仅服务端使用，不下发浏览器）",
        "key": "rpc_secret",
        "defaultValue": "aria2rpc_secret"
      },
      {
        "type": "textfield",
        "desc": "RPC 监听端口（默认 6800，请确认端口未被占用）",
        "key": "rpc_port",
        "defaultValue": "6800"
      }
    ]
  }
]
JSON
        ;;
    -s)
        # 提交结果在 $2（JSON），做最小校验
        payload="${2:-}"
        port=$(printf '%s' "$payload" | sed -n 's/.*"rpc_port"[[:space:]]*:[[:space:]]*"\([0-9]*\)".*/\1/p')
        if [ -n "$port" ] && { [ "$port" -lt 1 ] 2>/dev/null || [ "$port" -gt 65535 ] 2>/dev/null; }; then
            echo "RPC 端口必须在 1-65535 之间" >&2
            exit 1
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
