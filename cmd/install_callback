#!/bin/bash
### 安装时复用 config_callback 生成配置与 hook 脚本，避免双份维护
### config_callback 已含模板存在性检查、端口/密钥继承、.aria2 清理

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

if [ -n "$CMD_DIR" ] && [ -f "$CMD_DIR/config_callback" ]; then
    bash "$CMD_DIR/config_callback"
    exit $?
fi

# 兜底：按框架变量定位
if [ -n "${TRIM_APPDEST:-}" ] && [ -f "${TRIM_APPDEST}/cmd/config_callback" ]; then
    bash "${TRIM_APPDEST}/cmd/config_callback"
    exit $?
fi

echo "错误：未找到 config_callback，配置未生成" >&2
exit 1
