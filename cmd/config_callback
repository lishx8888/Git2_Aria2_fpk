#!/bin/bash
CONFIG_TEMPLATE="${TRIM_APPDEST}/template/aria2.tpl"
CONFIG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/data/aria2.conf"
TARGET_DIR="${TRIM_DATA_SHARE_PATHS%%:*}/data"
DOWNLOAD_DIR="${TRIM_DATA_SHARE_PATHS%%:*}/Download"
SERVER_DIR="${TRIM_APPDEST}/server"
ARIA2C_BIN="${SERVER_DIR}/aria2c"
SCRIPT_FILE="${TARGET_DIR}/on-download-complete"

# 重建软链接（升级/重装时可能失效）：优先从 PATH 查找，再兜底常见路径
mkdir -p "$SERVER_DIR"
rm -f "$SERVER_DIR/README.txt" 2>/dev/null
if [ ! -L "$ARIA2C_BIN" ]; then
    rm -f "$ARIA2C_BIN"
    ARIA2C_SRC=""
    if command -v aria2c >/dev/null 2>&1; then
        ARIA2C_SRC="$(command -v aria2c)"
    elif [ -x /usr/bin/aria2c ]; then
        ARIA2C_SRC="/usr/bin/aria2c"
    elif [ -x /usr/local/bin/aria2c ]; then
        ARIA2C_SRC="/usr/local/bin/aria2c"
    elif [ -x /opt/bin/aria2c ]; then
        ARIA2C_SRC="/opt/bin/aria2c"
    fi
    if [ -n "$ARIA2C_SRC" ]; then
        ln -sfT "$ARIA2C_SRC" "$ARIA2C_BIN"
    else
        echo "错误：系统中未找到 aria2c（已尝试 PATH、/usr/bin、/usr/local/bin、/opt/bin）" >&2
    fi
fi

# 始终重建 on-download-complete 钩子脚本（确保升级后旧版本被替换）
cat > "$SCRIPT_FILE" << 'HOOK'
#!/bin/bash
FILEPATH="$3"
[ -z "$FILEPATH" ] && exit 0
SCRIPT_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
trim() { sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
DOWNLOAD_DIR=$(sed -n 's/^[[:space:]]*dir[[:space:]]*=[[:space:]]*//p' "$SCRIPT_DIR/ui.conf" 2>/dev/null | head -1 | trim)
[ -z "$DOWNLOAD_DIR" ] && DOWNLOAD_DIR=$(sed -n 's/^[[:space:]]*dir[[:space:]]*=[[:space:]]*//p' "$SCRIPT_DIR/aria2.conf" 2>/dev/null | head -1 | trim)
OWNER=$(stat -c %u:%g "$DOWNLOAD_DIR" 2>/dev/null)
OWNER_UID=${OWNER%%:*}
if [ -n "$OWNER_UID" ] && [ "$OWNER_UID" != "0" ]; then
  chown -R "$OWNER" "$FILEPATH" 2>/dev/null
fi
# 下载完成后删除 .aria2 控制文件（force-save=true 时会保留，已无实际用途）
rm -f "${FILEPATH%/}.aria2" 2>/dev/null
exit 0
HOOK
chmod +x "$SCRIPT_FILE"

# 模板缺失时直接退出，避免写出空配置导致 aria2 无法启动
if [ ! -f "$CONFIG_TEMPLATE" ]; then
    echo "错误：模板文件不存在，跳过配置生成: $CONFIG_TEMPLATE" >&2
    exit 0
fi

# 向导未提供端口/密钥时（升级路径会复用本脚本），从现有配置继承，避免重置用户设置
if [ -f "$CONFIG_FILE" ]; then
    [ -z "${rpc_secret:-}" ] && rpc_secret="$(sed -n 's/^[[:space:]]*rpc-secret[[:space:]]*=[[:space:]]*//p' "$CONFIG_FILE" 2>/dev/null | head -n 1 | tr -d '\r')"
    [ -z "${rpc_port:-}" ] && rpc_port="$(sed -n 's/^[[:space:]]*rpc-listen-port[[:space:]]*=[[:space:]]*//p' "$CONFIG_FILE" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
fi
: "${rpc_secret:=aria2rpc_secret}"
: "${rpc_port:=6800}"

# 生成配置文件（先写临时文件，成功后再替换，避免中途失败留下残缺配置）
mkdir -p "$DOWNLOAD_DIR"
if sed \
  -e "s|\${PRC_SECRET}|${rpc_secret}|g" \
  -e "s|\${RPC_PORT}|${rpc_port}|g" \
  -e "s|\${DATA_DIR}|$TARGET_DIR|g" \
  -e "s|\${DOWNLOAD_DIR}|$DOWNLOAD_DIR|g" \
  -e "s|\${SCRIPT_PATH}|$SCRIPT_FILE|g" \
  "$CONFIG_TEMPLATE" > "${CONFIG_FILE}.tmp"; then
    mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
else
    rm -f "${CONFIG_FILE}.tmp"
    echo "错误：生成配置文件失败" >&2
    exit 1
fi

# 创建必需的空文件（升级/重装场景补建，已存在则保留原有下载记录）
for file in aria2.session dht.dat dht6.dat; do
  FILE_PATH="$TARGET_DIR/$file"
  [ ! -f "$FILE_PATH" ] && touch "$FILE_PATH"
done

exit 0
