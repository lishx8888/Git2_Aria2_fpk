#!/bin/bash

LOG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

CMD="${TRIM_APPDEST}/server/aria2c --conf-path=${TRIM_DATA_SHARE_PATHS%%:*}/data/aria2.conf --enable-rpc --rpc-listen-all"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    # 系统重启时共享数据目录可能尚未挂载完成，此时 aria2.conf 不存在，
    # aria2c 会忽略 --conf-path 用默认配置启动（默认 dir 不可写，任务全部立即失败）。
    # 此处等待配置就绪，最多 30 秒。
    local conf="${TRIM_DATA_SHARE_PATHS%%:*}/data/aria2.conf"
    local waited=0
    while [ ! -f "$conf" ] && [ $waited -lt 30 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [ ! -f "$conf" ]; then
        log_msg "错误：配置文件未就绪（已等待 ${waited}s），放弃启动: $conf"
        return 1
    fi
    [ "$waited" -gt 0 ] && log_msg "等待配置文件就绪 ${waited}s: $conf"

    # 软链接自愈：缺失时自动重建（优先 PATH，再兜底常见路径）
    local aria2c_bin="${TRIM_APPDEST}/server/aria2c"
    if [ ! -x "$aria2c_bin" ]; then
        mkdir -p "${TRIM_APPDEST}/server"
        local aria2c_src=""
        if command -v aria2c >/dev/null 2>&1; then
            aria2c_src="$(command -v aria2c)"
        elif [ -x /usr/bin/aria2c ]; then
            aria2c_src="/usr/bin/aria2c"
        elif [ -x /usr/local/bin/aria2c ]; then
            aria2c_src="/usr/local/bin/aria2c"
        elif [ -x /opt/bin/aria2c ]; then
            aria2c_src="/opt/bin/aria2c"
        fi
        if [ -n "$aria2c_src" ]; then
            ln -sfT "$aria2c_src" "$aria2c_bin"
        else
            log_msg "错误：系统中未找到 aria2c（已尝试 PATH、/usr/bin、/usr/local/bin、/opt/bin）"
        fi
    fi

    log_msg "Starting process ..."
    log_msg "conf: $conf"
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
